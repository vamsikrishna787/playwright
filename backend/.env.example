# Orchestration API
PORT=4000

# Where the Python agent API listens. Node never calls a model itself.
AGENT_API_URL=http://127.0.0.1:8000
AGENT_TIMEOUT_MS=180000

# Runs
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_MS=600000

# Lighthouse audits after each run. Set to 0 to switch off.
LIGHTHOUSE=1
LIGHTHOUSE_TIMEOUT_MS=180000
