# Server
PORT=3001

# AWS Bedrock
AWS_REGION=us-east-1
# Cross-region inference profile ID. Use the eu./apac. prefix if your region differs,
# and confirm the exact ID in the Bedrock console under Model access.
# Nova needs no use case form, unlike the Anthropic models on Bedrock.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Option A - Bedrock API key (starts with ABSK). Simplest for local use.
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-

# Option B - IAM credentials. Leave the key above blank to use these,
# or omit both and the default AWS SDK chain applies (`aws configure`, SSO, roles).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
