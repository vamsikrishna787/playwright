# Everything here is referenced from a profile in src/config as ${VAR:default}.
# The profile is the shape of the configuration; this file is the values that
# should not be committed with it.

# Which profile to load from src/config. Unset means "local".
# APP_ENV=local

# Mounted under a sub-path by an ingress. Next needs it at build time, so it is
# read from the environment rather than a profile. "" means served at the root.
# BASE_PATH=

# Page auth. middleware.ts runs in the Edge runtime and cannot read the
# profiles, so these two are environment-only — see the note in application.yml.
# AUTH_ENABLED=true
# AUTH_HEADER_NAME=x-remote-user

# The Python agent tier. Node never calls a model itself.
AGENT_API_URL=http://127.0.0.1:8000
AGENT_TIMEOUT_MS=180000

# Runs
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_MS=600000

# Lighthouse audits after each run. false switches them off.
LIGHTHOUSE=true
LIGHTHOUSE_TIMEOUT_MS=180000

# --- S3 storage -------------------------------------------------------------
# Only needed when storage.provider is s3, or when you want the Settings page
# toggle to be able to switch to it. Credentials are never read from here: the
# AWS SDK's own chain finds them, which is what lets the same image run against
# a developer's access keys and a pod's IAM role.
# S3_BUCKET=my-playwright-bucket
# AWS_REGION=us-east-1
# S3_PREFIX=playwright
# Set both of these for MinIO or another S3-compatible endpoint.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
